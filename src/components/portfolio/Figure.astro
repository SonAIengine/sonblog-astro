---
import type { Project } from "./content";

type Props = {
  figure: NonNullable<Project["figure"]>;
  class?: string;
  eager?: boolean;
};
const { figure: f, class: cls, eager = false } = Astro.props;
---

<figure class:list={["pf-figure", cls]}>
  <a href={f.src} target="_blank" rel="noopener" data-lightbox>
    <picture>
      {
        f.mobileSrc && (
          <source media="(max-width: 600px)" srcset={f.mobileSrc} />
        )
      }
      <img
        src={f.src}
        alt={f.alt}
        width={f.width}
        height={f.height}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
        decoding="async"
      />
    </picture>
  </a>
  <figcaption>{f.caption}</figcaption>
</figure>
