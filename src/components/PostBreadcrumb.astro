---
type BreadcrumbItem = {
  name: string;
  url: string;
};

type Props = {
  items: BreadcrumbItem[];
};

const { items } = Astro.props;
---

{
  items.length > 1 && (
    <nav
      class="post-breadcrumb app-layout"
      aria-label="breadcrumb"
      data-pagefind-ignore
    >
      <ol>
        {items.map((item, index) => {
          const isCurrent = index === items.length - 1;
          return (
            <li>
              {isCurrent ? (
                <span class="post-breadcrumb-current" aria-current="page">
                  {item.name}
                </span>
              ) : (
                <>
                  <a href={item.url}>{item.name}</a>
                  <span aria-hidden="true">/</span>
                </>
              )}
            </li>
          );
        })}
      </ol>
    </nav>
  )
}

<style>
  .post-breadcrumb {
    margin-top: 1.25rem;
  }

  .post-breadcrumb ol {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.45rem;
    overflow: hidden;
    color: var(--muted-foreground);
    font-family: var(--font-app);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .post-breadcrumb li {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.45rem;
  }

  .post-breadcrumb a {
    color: inherit;
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 0.25rem;
  }

  .post-breadcrumb a:hover {
    color: var(--accent);
  }

  .post-breadcrumb-current {
    display: block;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
