---
import { getCollection } from "astro:content";
import { getCompatibilityPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";

export async function getStaticPaths() {
  return getSortedPosts(await getCollection("posts")).map(post => ({
    params: { slug: getCompatibilityPostSlug(post.id, post.filePath) },
    props: { destination: getPostUrl(post.id, post.filePath) },
  }));
}

type Props = {
  destination: string;
};

return Astro.redirect(Astro.props.destination, 301);
---
