---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
const aboutURL = new URL("/about/", Astro.site ?? config.site.url).href;
const sameAs = [
  ...new Set(
    [config.site.profile, ...config.socials.map(social => social.url)].filter(
      (url): url is string => Boolean(url && /^https?:\/\//.test(url))
    )
  ),
];
const profileStructuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${aboutURL}#profile`,
  url: aboutURL,
  name: `${about.data.title} | ${config.site.title}`,
  description: about.data.description,
  inLanguage: config.site.lang,
  mainEntity: {
    "@type": "Person",
    "@id": `${aboutURL}#person`,
    name: config.site.author,
    url: aboutURL,
    jobTitle: "AI Engineer",
    description: about.data.description,
    ...(sameAs.length > 0 && { sameAs }),
  },
};
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(profileStructuredData)}
    />
  </Fragment>

  <Header />

  <Breadcrumb />

  <Main pageTitle={about.data.title} class="app-prose">
    <Content />
  </Main>

  <Footer />
</Layout>
